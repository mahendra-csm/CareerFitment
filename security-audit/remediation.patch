+// Storage rules tests on the local emulator (never a real bucket):
+//   npx firebase emulators:exec --only storage --project demo-careerfit \
+//     "node --test tests/rules/storage.rules.spec.mjs"
+import { test, before, after } from "node:test";
+import { readFileSync } from "node:fs";
+import { initializeTestEnvironment, assertFails, assertSucceeds } from "@firebase/rules-unit-testing";
+import { ref, uploadBytes, getBytes } from "firebase/storage";
+
+let env;
+before(async () => {
+  const [host, port] = (process.env.FIREBASE_STORAGE_EMULATOR_HOST || "127.0.0.1:9199").split(":");
+  env = await initializeTestEnvironment({
+    projectId: "demo-careerfit",
+    storage: { rules: readFileSync(process.env.STORAGE_RULES_FILE || new URL("../../storage.rules", import.meta.url), "utf8"), host, port: Number(port) },
+  });
+});
+after(async () => { await env?.cleanup(); });
+
+const st = (uid, claims = {}) => (uid ? env.authenticatedContext(uid, { email: `${uid}@example.com`, ...claims }) : env.unauthenticatedContext()).storage();
+const pdf = new Uint8Array([37, 80, 68, 70]);
+const put = (s, p, bytes = pdf, contentType = "application/pdf") => uploadBytes(ref(s, p), bytes, { contentType });
+
+test("owner can upload and read their own vault document", async () => {
+  await assertSucceeds(put(st("alice"), "scholarshipVault/alice/marksheet_10-1.pdf"));
+  await assertSucceeds(getBytes(ref(st("alice"), "scholarshipVault/alice/marksheet_10-1.pdf")));
+});
+test("another student or anonymous user can't read or write it", async () => {
+  await env.withSecurityRulesDisabled(async (ctx) => { await put(ctx.storage(), "scholarshipVault/alice/x.pdf"); });
+  await assertFails(getBytes(ref(st("bob"), "scholarshipVault/alice/x.pdf")));
+  await assertFails(getBytes(ref(st(null), "scholarshipVault/alice/x.pdf")));
+  await assertFails(put(st("bob"), "scholarshipVault/alice/evil.pdf"));
+  await assertFails(put(st("bob"), "studyAbroadVault/alice/evil.pdf"));
+});
+test("only PDFs, images and Word files under 10 MB", async () => {
+  await assertFails(put(st("alice"), "studyAbroadVault/alice/x.html", new Uint8Array([60]), "text/html"));
+  await assertFails(put(st("alice"), "studyAbroadVault/alice/big.pdf", new Uint8Array(10 * 1024 * 1024 + 1)));
+  await assertSucceeds(put(st("alice"), "studyAbroadVault/alice/p.png", new Uint8Array([1]), "image/png"));
+  await assertSucceeds(put(st("alice"), "studyAbroadVault/alice/cv.docx", new Uint8Array([1]), "application/vnd.openxmlformats-officedocument.wordprocessingml.document"));
+});
+test("review proofs: owner writes, admin reads, others can't", async () => {
+  await assertSucceeds(put(st("alice"), "reviewVerification/alice/1-proof.pdf"));
+  await assertSucceeds(getBytes(ref(st("admin", { email: "support@onegrasp.com" }), "reviewVerification/alice/1-proof.pdf")));
+  await assertFails(getBytes(ref(st("bob"), "reviewVerification/alice/1-proof.pdf")));
+});
+test("everything else is closed", async () => {
+  await assertFails(put(st("alice"), "public/anything.pdf"));
+});
diff --git a/tests/security/coupons-outage.test.mjs b/tests/security/coupons-outage.test.mjs
