@@ -0,0 +1,35 @@
+# Typecheck + unit/security tests on every push and pull request (audit L-07:
+# the repository had no CI, so nothing stopped a regression reaching Vercel).
+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci --ignore-scripts --no-audit --no-fund
+      - run: npm run typecheck
+      - run: npm test
+      # Reported, not blocking, until the Next.js major upgrade lands
+      # (see security-audit/REMEDIATION_TRACKER.md).
+      - run: npm audit --omit=dev --audit-level=high
+        continue-on-error: true
