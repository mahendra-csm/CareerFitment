+// ---------------------------------------------------------------- C-03 / H-04
+function fakeDb() {
+  const docs = new Map();
+  const ref = (c, id) => ({ path: `${c}/${id}` });
+  return {
+    docs,
+    collection: (c) => ({ doc: (id) => ref(c, id) }),
+    async runTransaction(fn) {
+      const writes = [];
+      const out = await fn({
+        get: async (r) => ({ exists: docs.has(r.path), get: (f) => docs.get(r.path)?.[f] }),
+        set: (r, data, opts) => writes.push([r.path, data, opts]),
+      });
+      for (const [p, data, opts] of writes) docs.set(p, opts?.merge ? { ...(docs.get(p) ?? {}), ...data } : data);
+      return out;
+    },
+  };
+}
