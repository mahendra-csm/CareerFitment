+++ b/lib/payments/claim.ts
@@ -0,0 +1,60 @@
+/**
+ * Server-side record of a verified Razorpay payment (audit C-03 / H-04).
+ *
+ * Before this, a verified signature only made the route answer "success" and
+ * the BROWSER wrote `paid: true` to its own profile. Nothing tied the payment
+ * to the account, so one genuine (order_id, payment_id, signature) triple
+ * could be replayed from any number of accounts.
+ *
+ * claimPayment() runs in one Firestore transaction:
+ *   - payments/{paymentId} is created the first time, holding the payer's uid;
+ *   - a second claim of the same payment by the SAME uid is an idempotent
+ *     success (a retried request), by ANY OTHER uid it is refused;
+ *   - the payer's users/{uid} doc gets the paid fields with the Admin SDK, so
+ *     once firestore.rules stops students writing `paid` (see the remediation
+ *     plan) payment status no longer depends on the browser at all.
+ */
+
+export type ClaimResult = "claimed" | "already_yours" | "claimed_by_other";
+
+/** The minimal Firestore surface used here, so tests can pass a fake. */
+export interface ClaimDb {
+  collection(name: string): { doc(id: string): unknown };
+  runTransaction<T>(fn: (tx: {
+    get(ref: unknown): Promise<{ exists: boolean; get(field: string): unknown }>;
+    set(ref: unknown, data: Record<string, unknown>, opts?: { merge: boolean }): unknown;
+  }) => Promise<T>): Promise<T>;
+}
+
+export const PAYMENT_ID_RE = /^pay_[A-Za-z0-9]{6,40}$/;
+export const ORDER_ID_RE = /^order_[A-Za-z0-9]{6,40}$/;
+
+export async function claimPayment(
+  db: ClaimDb,
+  p: { uid: string; paymentId: string; orderId: string; amountPaise: number; couponCode: string | null; now?: Date }
+): Promise<ClaimResult> {
+  const at = (p.now ?? new Date()).toISOString();
+  const payRef = db.collection("payments").doc(p.paymentId);
+  const userRef = db.collection("users").doc(p.uid);
+  return db.runTransaction(async (tx) => {
+    const snap = await tx.get(payRef);
+    if (snap.exists) {
+      return snap.get("uid") === p.uid ? "already_yours" : "claimed_by_other";
+    }
+    tx.set(payRef, { uid: p.uid, orderId: p.orderId, amountPaise: p.amountPaise, couponCode: p.couponCode, at });
+    tx.set(
+      userRef,
+      {
+        paid: true,
+        paymentStatus: "paid",
+        paidAt: at,
+        paymentId: p.paymentId,
+        amountPaid: p.amountPaise / 100,
+        ...(p.couponCode ? { couponCode: p.couponCode } : {}),
+        paymentVerifiedBy: "server",
+      },
+      { merge: true }
+    );
+    return "claimed";
+  });
+}
