+test("C-03 claimPayment binds a payment to one account and refuses replays", async () => {
+  const { claimPayment } = await import("../../lib/payments/claim.ts");
+  const db = fakeDb();
+  const p = { paymentId: "pay_ABC123456", orderId: "order_XYZ123456", amountPaise: 4900, couponCode: null };
+  assert.equal(await claimPayment(db, { ...p, uid: "alice" }), "claimed");
+  assert.equal(db.docs.get("users/alice").paid, true);
+  assert.equal(db.docs.get("users/alice").paymentVerifiedBy, "server");
+  assert.equal(db.docs.get("payments/pay_ABC123456").uid, "alice");
+  assert.equal(await claimPayment(db, { ...p, uid: "alice" }), "already_yours", "retries are idempotent");
+  assert.equal(await claimPayment(db, { ...p, uid: "mallory" }), "claimed_by_other", "replay from another account refused");
+  assert.equal(db.docs.has("users/mallory"), false, "replayer is not marked paid");
+});
