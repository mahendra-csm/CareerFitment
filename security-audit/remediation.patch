diff --git a/lib/adminAuth.ts b/lib/adminAuth.ts
index 4bad73f..838b094 100644
--- a/lib/adminAuth.ts
+++ b/lib/adminAuth.ts
@@ -1,14 +1,28 @@
-// Simple shared-secret guard for admin-only endpoints. Set ADMIN_TOKEN in
-// .env.local for production; falls back to a dev default otherwise.
-export function getAdminToken(): string {
-  return process.env.ADMIN_TOKEN || "onegrasp-admin-dev";
+import { createHash, timingSafeEqual } from "crypto";
+
+// Shared-secret guard for admin-only endpoints (GET /api/leads).
+//
+// Fails CLOSED: with ADMIN_TOKEN unset (or shorter than 24 characters) every
+// request is refused. There used to be a hardcoded fallback token here, which
+// is public in the repository - on any deployment without ADMIN_TOKEN it let
+// anyone list every captured lead. See security-audit/SECURITY_AUDIT_REPORT.md.
+export const MIN_ADMIN_TOKEN_LENGTH = 24;
+
+/** The configured admin token, or null when none (or a too-short one) is set. */
+export function getAdminToken(): string | null {
+  const t = (process.env.ADMIN_TOKEN || "").trim();
+  return t.length >= MIN_ADMIN_TOKEN_LENGTH ? t : null;
 }
 
+const digest = (s: string) => createHash("sha256").update(s, "utf8").digest();
+
 /** True when the request carries the correct admin token. */
 export function isAuthorizedAdmin(req: Request): boolean {
   const expected = getAdminToken();
-  const header =
-    req.headers.get("authorization") || req.headers.get("x-admin-token") || "";
+  if (!expected) return false;
+  const header = req.headers.get("authorization") || req.headers.get("x-admin-token") || "";
   const provided = header.replace(/^Bearer\s+/i, "").trim();
-  return provided.length > 0 && provided === expected;
+  if (!provided) return false;
+  // Compare fixed-length digests so neither length nor content leaks via timing.
+  return timingSafeEqual(digest(provided), digest(expected));
 }
