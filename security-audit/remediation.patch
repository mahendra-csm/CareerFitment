@@ -0,0 +1,25 @@
+// H-03 lives in its own file: lib/firebase/admin caches its credentials for
+// the life of the process, so it needs a fresh process with the env set first.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+// ---------------------------------------------------------------- H-03
+test("H-03 a coupon-store outage never enables the public 100%-off fallback", async () => {
+  const saved = { ...process.env };
+  // Configured but unusable credentials: the Firestore read throws.
+  process.env.FIREBASE_PROJECT_ID = "test-project";
+  process.env.FIREBASE_CLIENT_EMAIL = "x@test-project.iam.gserviceaccount.com";
+  process.env.FIREBASE_PRIVATE_KEY = "not-a-key";
+  const err = console.error; console.error = () => {};
+  try {
+    const { getCoupons } = await import("../../lib/coupons.ts");
+    const list = await getCoupons();
+    assert.ok(list.every((c) => c.percentOff < 100), "no full waiver on error");
+  } finally {
+    console.error = err;
+    for (const k of ["FIREBASE_PROJECT_ID", "FIREBASE_CLIENT_EMAIL", "FIREBASE_PRIVATE_KEY"]) {
+      if (saved[k] === undefined) delete process.env[k]; else process.env[k] = saved[k];
+    }
+  }
+});
+
