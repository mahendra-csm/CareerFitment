diff --git a/storage.rules b/storage.rules
new file mode 100644
index 0000000..5fd39be
--- /dev/null
+++ b/storage.rules
@@ -0,0 +1,53 @@
+rules_version = '2';
+
+// Firebase Storage security rules - RECOMMENDED by the security audit
+// (security-audit/SECURITY_AUDIT_REPORT.md, H-07). Storage rules were not in
+// the repository, so what is deployed is unknown. Compare with the console
+// (Storage -> Rules) and deploy with `firebase deploy --only storage`.
+//
+// The vaults hold identity documents (marksheets, bank passbooks, passports),
+// so the default is deny and each folder is owner-only.
+service firebase.storage {
+  match /b/{bucket}/o {
+
+    function isAdmin() {
+      return request.auth != null
+        && request.auth.token.email in ['support@onegrasp.com'];
+    }
+    function isOwner(uid) {
+      return request.auth != null && request.auth.uid == uid;
+    }
+    // PDFs, images and Word documents (CVs, SOPs, LORs), at most 10 MB.
+    function validDocument() {
+      return request.resource.size < 10 * 1024 * 1024
+        && (request.resource.contentType == 'application/pdf'
+            || request.resource.contentType.matches('image/(png|jpeg|webp|heic|heif)')
+            || request.resource.contentType == 'application/msword'
+            || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
+    }
+
+    // lib/scholarships/clientVault.ts
+    match /scholarshipVault/{uid}/{file} {
+      allow read, delete: if isOwner(uid);
+      allow create: if isOwner(uid) && validDocument();
+      allow update: if false;
+    }
+    // lib/studyAbroad/clientVault.ts
+    match /studyAbroadVault/{uid}/{file} {
+      allow read, delete: if isOwner(uid);
+      allow create: if isOwner(uid) && validDocument();
+      allow update: if false;
+    }
+    // lib/studyAbroad/clientReviews.ts - proof of enrolment for a review;
+    // staff verify it, so admins may read it.
+    match /reviewVerification/{uid}/{file} {
+      allow read: if isOwner(uid) || isAdmin();
+      allow create: if isOwner(uid) && validDocument();
+      allow update, delete: if false;
+    }
+
+    match /{allPaths=**} {
+      allow read, write: if false;
+    }
+  }
+}
