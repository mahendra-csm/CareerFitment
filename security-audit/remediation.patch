diff --git a/tests/rules/firestore.rules.spec.mjs b/tests/rules/firestore.rules.spec.mjs
new file mode 100644
index 0000000..72ab19d
--- /dev/null
+++ b/tests/rules/firestore.rules.spec.mjs
@@ -0,0 +1,100 @@
+// Firestore security-rules tests, run against the local emulator (never a
+// real project). Not part of `npm test` because it needs the emulator:
+//
+//   npm i -D firebase-tools@13 @firebase/rules-unit-testing@3 firebase@10
+//   npx firebase emulators:exec --only firestore --project demo-careerfit \
+//     "node --test tests/rules/firestore.rules.spec.mjs"
+//
+// Tests marked KNOWN GAP assert today's (insecure) behaviour on purpose; they
+// are expected to flip once the approval-gated rule changes in
+// security-audit/REMEDIATION_TRACKER.md are applied.
+import { test, before, after, beforeEach } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { initializeTestEnvironment, assertFails, assertSucceeds } from "@firebase/rules-unit-testing";
+import { doc, getDoc, setDoc, updateDoc, getDocs, collection, query, where } from "firebase/firestore";
+
+const RULES = process.env.RULES_FILE || new URL("../../firestore.rules", import.meta.url);
+let env;
+
+before(async () => {
+  const [host, port] = (process.env.FIRESTORE_EMULATOR_HOST || "127.0.0.1:8080").split(":");
+  env = await initializeTestEnvironment({
+    projectId: "demo-careerfit",
+    firestore: { rules: readFileSync(RULES, "utf8"), host, port: Number(port) },
+  });
+});
+after(async () => { await env?.cleanup(); });
+beforeEach(async () => {
+  await env.clearFirestore();
+  await env.withSecurityRulesDisabled(async (ctx) => {
+    const db = ctx.firestore();
+    await setDoc(doc(db, "users/alice"), { uid: "alice", name: "Alice", institution: "School A", paid: false });
+    await setDoc(doc(db, "users/bob"), { uid: "bob", name: "Bob", paid: false });
+    await setDoc(doc(db, "coupons/FREE"), { code: "FREE", percentOff: 100 });
+    await setDoc(doc(db, "settings/payment"), { enabled: true });
+    await setDoc(doc(db, "researchProfiles/alice-r"), { uid: "alice", name: "Alice" });
+  });
+});
+
+const as = (uid, claims = {}) => env.authenticatedContext(uid, { email: `${uid}@example.com`, ...claims }).firestore();
+const anon = () => env.unauthenticatedContext().firestore();
+const REG = (uid) => ({ uid, name: "N", email: `${uid}@example.com`, phone: "1", institution: "School A", desiredCareer: "", category: "class_12", journeyCode: "x", clarity: "x", city: "", age: "", paid: false, paymentStatus: "unpaid" });
+
+test("registration payload is still accepted (no regression)", async () => {
+  await assertSucceeds(setDoc(doc(as("carol"), "users/carol"), REG("carol")));
+});
+test("H-05 can't create own profile already paid", async () => {
+  await assertFails(setDoc(doc(as("carol"), "users/carol"), { ...REG("carol"), paid: true }));
+});
+test("H-05 can't create own profile carrying server-only fields", async () => {
+  for (const f of ["certificates", "testDrives", "decision", "boosterRequests", "institutionalLinkCode"]) {
+    await assertFails(setDoc(doc(as("carol"), "users/carol"), { ...REG("carol"), [f]: { x: 1 } }), f);
+  }
+});
+test("can't create someone else's profile, or one with a forged uid field", async () => {
+  await assertFails(setDoc(doc(as("carol"), "users/dave"), REG("dave")));
+  await assertFails(setDoc(doc(as("carol"), "users/carol"), REG("dave")));
+});
+test("IDOR: can't read or write another student's profile", async () => {
+  await assertFails(getDoc(doc(as("bob"), "users/alice")));
+  await assertFails(updateDoc(doc(as("bob"), "users/alice"), { name: "x" }));
+  await assertFails(getDoc(doc(anon(), "users/alice")));
+});
+test("can't change own school link or certificates after sign-up", async () => {
+  await assertFails(updateDoc(doc(as("alice"), "users/alice"), { institution: "School B" }));
+  await assertFails(updateDoc(doc(as("alice"), "users/alice"), { certificates: { a: 1 } }));
+});
+test("KNOWN GAP (C-03): a student can still mark themselves paid", async () => {
+  await assertSucceeds(updateDoc(doc(as("alice"), "users/alice"), { paid: true, paymentStatus: "paid" }));
+});
+test("students can't read coupons or payment settings", async () => {
+  await assertFails(getDoc(doc(as("alice"), "coupons/FREE")));
+  await assertFails(getDocs(collection(as("alice"), "coupons")));
+  await assertFails(setDoc(doc(as("alice"), "settings/payment"), { enabled: false }));
+});
+test("server-only collections are closed to clients", async () => {
+  for (const p of ["institutions/x", "institutionAccounts/alice", "institutionMessages/x", "leads/x", "payments/pay_x", "aiUsage/x"]) {
+    await assertFails(getDoc(doc(as("alice"), p)), p);
+  }
+});
+test("admin email can read any profile", async () => {
+  await assertSucceeds(getDoc(doc(as("admin1", { email: "support@onegrasp.com", email_verified: true }), "users/alice")));
+});
+test("KNOWN GAP (M-03): admin check doesn't require a verified email", async () => {
+  await assertSucceeds(getDoc(doc(as("admin2", { email: "support@onegrasp.com", email_verified: false }), "users/alice")));
+});
+test("research profiles: open by link, not listable by others", async () => {
+  await assertSucceeds(getDoc(doc(anon(), "researchProfiles/alice-r")));
+  await assertFails(getDocs(collection(as("bob"), "researchProfiles")));
+  await assertSucceeds(getDocs(query(collection(as("alice"), "researchProfiles"), where("uid", "==", "alice"))));
+});
+test("study-abroad reviews can't be self-published", async () => {
+  await assertFails(setDoc(doc(as("alice"), "studyAbroadReviews/r1"), { uid: "alice", status: "published" }));
+  await assertSucceeds(setDoc(doc(as("alice"), "studyAbroadReviews/r2"), { uid: "alice", status: "pending_verification" }));
+});
+test("owner-only records reject cross-user writes", async () => {
+  await assertFails(setDoc(doc(as("bob"), "researchProjects/p1"), { uid: "alice", title: "x" }));
+  await assertSucceeds(setDoc(doc(as("alice"), "researchProjects/p1"), { uid: "alice", title: "x" }));
+  await assertFails(getDoc(doc(as("bob"), "researchProjects/p1")));
+});
