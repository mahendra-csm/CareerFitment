new file mode 100644
index 0000000..f7aa749
--- /dev/null
+++ b/lib/security/requestAuth.ts
@@ -0,0 +1,52 @@
+/**
+ * Small, dependency-light helpers for authenticating API requests.
+ *
+ * bearerIdentity() verifies the Firebase ID token from "Authorization: Bearer"
+ * with Google's account lookup (lib/firebase/adminAuth.ts verifySignIn). It
+ * needs no Admin SDK credentials, so routes that must work on deployments
+ * without them can still require a signed-in caller.
+ */
+import { verifySignIn } from "@/lib/firebase/adminAuth";
+
+export function bearerToken(req: Request): string {
+  const header = req.headers.get("authorization") || "";
+  return /^Bearer\s+/i.test(header) ? header.replace(/^Bearer\s+/i, "").trim() : "";
+}
+
+/** The verified caller, or null when there is no valid ID token. */
+export async function bearerIdentity(
+  req: Request,
+  verify: (token: string) => Promise<{ uid: string; email: string } | null> = verifySignIn
+): Promise<{ uid: string; email: string } | null> {
+  const token = bearerToken(req);
+  if (!token) return null;
+  try {
+    const id = await verify(token);
+    return id && id.uid ? id : null;
+  } catch {
+    return null;
+  }
+}
+
+/** An http(s) URL, or "" - anything else (javascript:, data:, garbage) is dropped. */
+export function safeHttpUrl(v: unknown, max = 500): string {
+  const s = String(v ?? "").trim().slice(0, max);
+  if (!s) return "";
+  try {
+    const u = new URL(s);
+    return u.protocol === "https:" || u.protocol === "http:" ? u.toString() : "";
+  } catch {
+    return "";
+  }
+}
+
+/** Plain single-line text, control characters removed, length-capped. */
+export function plainText(v: unknown, max: number): string {
+  return String(v ?? "").replace(/[\u0000-\u001f\u007f]+/g, " ").trim().slice(0, max);
+}
+
+/** An in-app path like "/account/exams?tab=1" - never "//host" or "/\host"
+ *  (browsers treat those as another site), or "" when it isn't one. */
+export function safeInternalPath(v: unknown): string {
+  return typeof v === "string" && /^\/(?![/\\])[A-Za-z0-9/_\-?=&.#]*$/.test(v) && v.length <= 300 ? v : "";
+}
